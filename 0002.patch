--- a/backend/.env.example
+++ b/backend/.env.example
@@ -1,16 +1,26 @@
 PORT=3333
 
-# Supabase: Project Settings > Database > Connection string > "Session pooler".
-# Use o usuário app_createit (criado no 03_seguranca.sql) no lugar de "postgres":
-# o formato é app_createit.<id-do-projeto> e a senha é a que você definiu no script.
-DATABASE_URL=postgresql://app_createit.xxxxxxxxxxxxxxxxxxxx:TroqueEstaSenha123@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
+# MySQL 8. Formato: mysql://usuario:senha@host:porta/banco
+#
+# Aiven (nuvem): painel do serviço > Overview > "Service URI" (a porta NÃO é a 3306).
+# Troque o final (/defaultdb) por /createit e use o usuário app_createit criado no
+# database-mysql/03_seguranca.sql (ou o avnadmin, se não conseguir criar o usuário).
+# Se a senha tiver caracteres especiais (@ : / # ?), escreva-os em formato de URL (ex.: @ vira %40).
+DATABASE_URL=mysql://app_createit:TroqueEstaSenha123@mysql-xxxx-seu-projeto.aivencloud.com:12345/createit
 
-# Para usar um Postgres local em vez do Supabase:
-# DATABASE_URL=postgres://app_createit:TroqueEstaSenha123@localhost:5432/createit
+# MySQL local (rodar os scripts da pasta database-mysql com o usuário root):
+# DATABASE_URL=mysql://app_createit:TroqueEstaSenha123@localhost:3306/createit
+
+# SSL: ligado sozinho para qualquer host que não seja localhost (o Aiven exige).
+# Por padrão a conexão é criptografada mas não confere o certificado. Para conferir,
+# cole aqui o conteúdo do ca.pem do Aiven (em uma linha, com \n no lugar das quebras de linha):
+# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
+# DB_SSL=false   # só para desligar o SSL à força
 
 JWT_SECRET=troque-por-uma-frase-grande-e-aleatoria
 
 # Fotos das ações (Supabase Storage). Sem isso o app funciona, só não aceita foto.
+# O banco agora é o MySQL; o Supabase só guarda as fotos (bucket público "fotos").
 # URL: Project Settings > Data API (https://<id-do-projeto>.supabase.co)
 # Chave: Project Settings > API Keys > Secret key (ou a "service_role", na aba Legacy).
 # Essa chave passa por cima de todas as permissões: nunca coloque no front-end.
