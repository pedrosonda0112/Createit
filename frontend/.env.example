# Endereço da API. Sem essa variável usa /api (o mesmo domínio, como na Vercel).
# VITE_API_URL=http://localhost:3333/api

# Tempo real (feed, curtidas e comentários atualizando sozinhos).
# Supabase > Project Settings > API Keys: use a chave "publishable" (sb_publishable_...),
# nunca a secret. Na Vercel, cadastre as duas em Settings > Environment Variables.
# Sem elas o site funciona normalmente, só não se atualiza sozinho.
VITE_SUPABASE_URL=https://<id-do-projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
