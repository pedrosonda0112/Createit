PORT=3333

# Supabase: Project Settings > Database > Connection string > "Session pooler".
# Use o usuário app_createit (criado no 03_seguranca.sql) no lugar de "postgres":
# o formato é app_createit.<id-do-projeto> e a senha é a que você definiu no script.
DATABASE_URL=postgresql://app_createit.xxxxxxxxxxxxxxxxxxxx:TroqueEstaSenha123@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Para usar um Postgres local em vez do Supabase:
# DATABASE_URL=postgres://app_createit:TroqueEstaSenha123@localhost:5432/createit

JWT_SECRET=troque-por-uma-frase-grande-e-aleatoria

# Fotos das ações (Supabase Storage). Sem isso o app funciona, só não aceita foto.
# URL: Project Settings > Data API (https://<id-do-projeto>.supabase.co)
# Chave: Project Settings > API Keys > Secret key (ou a "service_role", na aba Legacy).
# Essa chave passa por cima de todas as permissões: nunca coloque no front-end.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=fotos
