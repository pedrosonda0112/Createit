# Endereço da API (o mesmo back-end do site, que conecta no banco do Supabase).
# Em produção, use o domínio da Vercel:
# EXPO_PUBLIC_API_URL=https://<seu-projeto>.vercel.app/api
#
# Sem essa variável, em desenvolvimento o app usa o IP do computador que roda
# o "npx expo start" na porta 3333 (o "npm run dev" do backend).
EXPO_PUBLIC_API_URL=

# Tempo real (feed, curtidas e comentários atualizando sozinhos).
# Supabase > Project Settings > API Keys: use a chave "publishable" (sb_publishable_...),
# nunca a secret. Sem elas o app funciona normalmente, só não se atualiza sozinho.
EXPO_PUBLIC_SUPABASE_URL=https://<id-do-projeto>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
