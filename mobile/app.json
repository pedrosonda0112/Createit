{
  "expo": {
    "name": "Create It",
    "slug": "create-it",
    "version": "0.1.0",
    "scheme": "createit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b0c",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.createit.app"
    },
    "android": {
      "package": "com.createit.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Create It usa suas fotos para comprovar as ações sustentáveis que você registra.",
          "cameraPermission": "O Create It usa a câmera para fotografar as ações sustentáveis que você registra."
        }
      ]
    ]
  }
}
